{
  "name": "gemini-mcp-bridge",
  "version": "0.2.0",
  "description": "Chrome extension that lets Gemini on the web use the MCP tools of your own computer",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "node scripts/build.mjs --test && node --test --test-concurrency=1 e2e/mock.test.ts e2e/generic.test.ts",
    "e2e:live": "node scripts/build.mjs --test && GMB_LIVE=1 node --test e2e/live.test.ts",
    "zip": "npm run build && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "playwright": "1.65.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "zod": "4.6.7"
  }
}
